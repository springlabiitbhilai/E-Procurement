<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <style>

        @page {
            size: A4;
            margin-top: 150px;
            margin-bottom: 110px;
            margin-left: 20mm;
            margin-right: 20mm;
        }

        body {
            font-family: "Times New Roman", serif;
            font-size: 14px;
            line-height: 1.45;
            color: #000;
        }


        /* =========================
           MAIN CONTENT
        ========================== */

        .annexure {

            text-align: center;

            font-size: 24px;

            font-weight: bold;

            margin-top: 10px;

            text-decoration: underline;
        }

        .main-heading {

            text-align: center;

            font-size: 19px;

            font-weight: bold;

            margin-top: 18px;

            line-height: 1.4;
        }

        .project-title {

            text-align: center;

            font-size: 20px;

            font-weight: bold;

            color: #c00000;

            margin-top: 22px;

            line-height: 1.4;
        }

        .intro {

            margin-top: 28px;

            font-size: 18px;

            font-weight: bold;
        }

        .section {

            margin-top: 22px;
        }

        .section-title {

            font-size: 18px;

            font-style: italic;

            font-weight: bold;
        }

        .sub-content {

            margin-left: 55px;

            margin-top: 10px;
        }

        .sub-content p {

            margin: 6px 0;
        }

        .position-block {

            margin-top: 18px;
            margin-left: 35px;
            display: block;
        }

        .roman {

            margin-left: 45px;

            margin-top: 6px;
        }

        .roman p {

            margin: 5px 0;
        }

        ul {

            margin-top: 5px;

            margin-bottom: 10px;
        }

        li {

            margin-bottom: 4px;
        }

        .terms {

            margin-top: 28px;
        }

        .terms h3 {

            margin-bottom: 12px;
        }

        .terms ol {

            padding-left: 25px;
        }

        .terms li {

            margin-bottom: 10px;

            text-align: justify;
        }

       

    </style>
</head>

<body>


    <!-- ANNEXURE -->

    <div class="annexure">
        Annexure I
    </div>

    <!-- MAIN HEADING -->

    <div class="main-heading">

        Advertisement to recruit staff members on a temporary basis
        in the sponsored research project

        <br>

        Entitled:

    </div>

    <!-- PROJECT TITLE -->

    <div class="project-title">

        “<%= projectTitle %>”

    </div>

    <!-- INTRO -->

    <div class="intro">

        Other details of the project are as follows.

    </div>

    <!-- PI DETAILS -->

    <div class="section">

        <span class="section-title">
            1.&nbsp; Principal Investigator:
        </span>

        <div class="sub-content">

            <p>
                a.&nbsp; Name:
                <%= piName %>
            </p>

            <p>
                b.&nbsp; Designation:
                <%= piDesignation %>
            </p>

            <p>
                c.&nbsp; Department:
                <%= piDepartment %>
            </p>
            <p>
                c.&nbsp; Office Address:
                <%= officeAddress %>
            </p>

            <p>
                d.&nbsp; Email:
                <%= piEmail %>
            </p>

            <p>
                e.&nbsp; Website:
                <%= piWebsite %>
            </p>

        </div>

    </div>

    <!-- SPONSOR -->

    <div class="section">

        <span class="section-title">
            2.&nbsp; Sponsoring Agency:
        </span>

        <span style="margin-left:10px;">
            <%= sponsoringAgency %>
        </span>

    </div>

    <!-- POSITIONS -->

    <div class="section">

        <span class="section-title">
            3.&nbsp; Details of available positions and posts:
        </span>

        <% positions.forEach((position, index) => { %>

            <div class="position-block">

                <p>

                    <strong>
                        <%= String.fromCharCode(97 + index) %>.
                    </strong>

                    <strong>
                        Name of the position:
                    </strong>

                    <%= position.positionName %>

                </p>

                <div class="roman">

                    <p>
                        i.&nbsp;
                        <strong>Number of Posts:</strong>
                        <%= position.numberOfPosts %>
                    </p>

                    <p>
                        ii.&nbsp;
                        <strong>Essential qualifications:</strong>
                    </p>

                    <ul>

                        <% position.essentialQualifications.forEach((q) => { %>

                            <li><%= q %></li>

                        <% }) %>

                    </ul>

                    <p>
                        iii.&nbsp;
                        <strong>Age limit:</strong>
                        <%= position.ageLimit %>
                    </p>

                    <p>
                        iv.&nbsp;
                        <strong>Salary range:</strong>
                        ₹ <%= position.salaryStart %> - ₹ <%= position.salaryEnd %>
                    </p>

                    <p>
                        v.&nbsp;
                        <strong>Duration:</strong>
                        <%= position.duration %>
                    </p>

                    <p>
                        vii.&nbsp;
                        <strong>Desirable qualifications:</strong>
                    </p>

                    <ul>

                        <% position.desirableQualifications.forEach((q) => { %>

                            <li><%= q %></li>

                        <% }) %>

                    </ul>

                </div>

            </div>

        <% }) %>

    </div>

    <!-- APPLICATION DETAILS -->

    <div class="section">

        <span class="section-title">
            4.&nbsp; How to apply:
        </span>

        <div class="sub-content">

            <p>
                ● Documents to submit:
                Filled-out application form (attached in the advertisement) and updated CV.
            </p>

            <p>
                ● To whom to submit:
                To the PI by email.
            </p>

            <p>
               <strong>● Subject-line of the email:</strong>
                <%= emailSubject %>
            </p>

            <p>
                ● Submission Email:
                <%= submissionEmail %>
            </p>

            <p>
                ● Submission deadline (Hard):
                <strong>
                    <%= submissionDeadline %>
                </strong>
            </p>

        </div>

    </div>

    <!-- INTERVIEW -->

    <div class="section">

        <p>
            <strong>5.&nbsp; Mode and date of interview:</strong>
            <%= interviewMode %> ,
            <%= interviewDate %>
        </p>

        <p>
            <strong>6.&nbsp; Venue:</strong>
            <%= venue %>
        </p>
        <p>
  <strong>Reporting Time:</strong>
  <%= reportingTime || "NA" %>
</p>

    </div>

    <!-- TERMS -->

    <div class="terms">

        <h3>Terms & Conditions:</h3>

        <ol type="i">

            <li>
        No TA/DA will be provided to the candidate for the interview.
    </li>

    <li>
        The decision of the selection committee will be final.
    </li>

    <li>
        If the number of candidates appearing for the interview is large, the selection committee may decide to restrict the number of candidates for the interview to a reasonable limit after considering qualifications and experience over and above the minimum prescribed in the advertisement.
    </li>

    <li>
        The appointment of the candidate will be governed by the terms and conditions of the Institute / Funding agency particularly applicable to the said project as and when required.
    </li>

    <li>
        The selected candidate will have to join duty immediately on receipt of the offer.
    </li>

    <li>
        The fellowship may be terminated with a 30-day notice before completion of the tenure if performance till date is not deemed satisfactory.
    </li>

    <li>
        IIT Bhilai based on the performance of the candidates reserves the right to fill or not to fill any or all the posts.
    </li>

        </ol>

    </div>


</body>

</html>